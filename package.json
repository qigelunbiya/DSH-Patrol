{
  "name": "dsh-patrol",
  "version": "0.2.0-alpha.1",
  "description": "Browser patrol and website inspection plugin for DeepSeek Harness: teach once, replay deterministic runbooks with managed Chromium, credentials, screenshots, checkpoints, and selector recovery.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qigelunbiya/DSH-Patrol.git"
  },
  "homepage": "https://github.com/qigelunbiya/DSH-Patrol#readme",
  "bugs": {
    "url": "https://github.com/qigelunbiya/DSH-Patrol/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "browser-automation",
    "website-monitoring",
    "web-automation",
    "ai-agent",
    "runbook",
    "puppeteer",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser-bridge": {
      "default": "./browser-bridge-runtime/index.js"
    },
    "./browser-bridge-host": {
      "default": "./browser-bridge-runtime/index.js"
    },
    "./browser-tools": {
      "default": "./browser-bridge-runtime/tools-plugin.js"
    },
    "./preset-installer": {
      "types": "./lib/preset-installer.d.ts",
      "default": "./lib/preset-installer.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.map",
    "cordis.patch.yml",
    "presets/**/*",
    "browser-extension/**/*",
    "browser-bridge-runtime/**/*",
    "client-host-runtime/**/*",
    "excel-runtime/**/*",
    "cleanup-runtime/**/*",
    "docs/**/*",
    "scripts/install-local.ps1",
    "scripts/install-captcha-demo.ps1",
    "scripts/uninstall-local.ps1",
    "scripts/set-patrol-credential.ps1",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "catalog": {
      "category": "workflow",
      "summary": {
        "en": "Teach browser inspections once, then replay deterministic patrol runbooks with managed Chromium, screenshots, credential references, checkpoints, and conservative selector recovery.",
        "zh": "用自然语言教一次网页巡检，随后由确定性 Runbook 稳定重放；内置受管 Chromium、截图、凭据引用、断点恢复和保守的选择器自愈。"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --pretty false",
    "prepare": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --testTimeout=30000",
    "test:watch": "vitest",
    "check:extension": "node scripts/check-extension.mjs && node scripts/check-frame-extension.mjs && node scripts/check-managed-browser.mjs && node scripts/check-client-runtime.mjs",
    "check:encoding": "node scripts/check-encoding.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@napi-rs/system-ocr": "1.1.0",
    "puppeteer-core": "25.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
