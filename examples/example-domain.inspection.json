{
  "schemaVersion": "0.2",
  "id": "example-domain",
  "name": "Example Domain 巡检",
  "description": "打开 Example Domain，确认页面文本并保存截图与页面文本。",
  "status": "ready",
  "target": {
    "type": "browser",
    "url": "https://example.com"
  },
  "expectedResult": "页面包含 Example Domain",
  "artifacts": [
    "markdown-report",
    "json-report",
    "screenshot",
    "page-text",
    "page-summary"
  ],
  "auth": {
    "mode": "none"
  },
  "schedule": null,
  "steps": [
    {
      "id": "step-001",
      "kind": "tool",
      "name": "打开页面",
      "tool": "browser_navigate",
      "arguments": {
        "url": "https://example.com",
        "action": "navigate"
      },
      "recordedAt": "2026-08-27T00:00:00.000Z"
    },
    {
      "id": "step-002",
      "kind": "tool",
      "name": "读取页面",
      "tool": "browser_read_page",
      "arguments": {
        "maxChars": 20000
      },
      "expectation": {
        "mode": "contains",
        "value": "Example Domain",
        "caseSensitive": false
      },
      "artifact": "page-text",
      "recordedAt": "2026-08-27T00:00:01.000Z"
    },
    {
      "id": "step-003",
      "kind": "tool",
      "name": "保存截图",
      "tool": "browser_screenshot",
      "arguments": {
        "format": "png"
      },
      "artifact": "screenshot",
      "recordedAt": "2026-08-27T00:00:02.000Z"
    }
  ],
  "metadata": {
    "createdAt": "2026-08-27T00:00:00.000Z",
    "updatedAt": "2026-08-27T00:00:02.000Z",
    "validatedAt": "2026-08-27T00:00:02.000Z"
  }
}
